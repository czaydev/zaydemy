{
	"name": "zaydemy",
	"private": true,
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"db:migrate": "pnpm --filter @zaydemy/web db:migrate",
		"db:seed": "pnpm --filter @zaydemy/web db:seed"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"turbo": "^2.11.7",
		"typescript": "^5.9.3"
	}
}
