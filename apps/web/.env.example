DATABASE_URL=postgres://postgres@localhost:5432/zaydemy
# Commercial licence token; needed only for enterprise plugins or white-label.
ZAYDEMY_LICENSE=
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: enables "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Card payments (better-payment); set PAYMENT_MODE=production for live keys.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
PAYMENT_MODE=sandbox
# Optional integrations; each plugin turns on when its variables are set (integrations.ts).
POSTMARK_SERVER_TOKEN=
MAIL_FROM="Zaydemy <noreply@example.com>"
EKOMESAJ_USERNAME=
EKOMESAJ_PASSWORD=
SMS_SENDER_NAME=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
SENTRY_DSN=
SENTRY_ENVIRONMENT=
DISCORD_FEEDBACK_WEBHOOK_URL=
# Admin account created by `pnpm db:seed` (defaults: admin@example.com with a generated password, printed by the seed).
ADMIN_EMAIL=
ADMIN_PASSWORD=
